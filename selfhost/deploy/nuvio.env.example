# Settings for install.sh: copy to nuvio.env (not committed) and fill in the CHANGE_ME values.
# No secrets here: those are generated into $NUVIO_DIR/.env.

# Hostname the TVs use. LAN only: point it at docker-prod with an AdGuard DNS rewrite.
NUVIO_DOMAIN=CHANGE_ME

# Where the NuvioMedia/self-host checkout lives on docker-prod.
NUVIO_DIR=/opt/nuvio-self-host

# Traefik routing: "labels" (the Nuvio gateway joins TRAEFIK_NETWORK with router labels; nothing
# to change in Traefik) or "file" (use traefik-dynamic.yml with your file provider instead).
TRAEFIK_MODE=labels
TRAEFIK_NETWORK=proxy
TRAEFIK_ENTRYPOINT=websecure
# The certificate resolver your other internal services use. For a LAN-only host it has to
# be a DNS challenge (or a wildcard), since Let's Encrypt can't reach it over HTTP.
TRAEFIK_CERTRESOLVER=CHANGE_ME
# Traefik v3: ipallowlist. Traefik v2: ipwhitelist.
TRAEFIK_IPALLOW_KEY=ipallowlist

# Who may connect (comma separated CIDR ranges, e.g. 192.168.1.0/24). Your LAN; add a VPN range (WireGuard/Tailscale) if you use one.
NUVIO_LAN_RANGES=CHANGE_ME
